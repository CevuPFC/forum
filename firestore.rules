rules_version = '2';

// Firestore pravila za Glas.
// Firebase konzola > Firestore Database > Rules > nalepi ceo fajl > Publish.
//
// Šta pravila obezbeđuju:
//  - samo prijavljen učenik može da piše objave, komentare i da glasa
//  - niko ne može da se predstavi tuđim imenom
//  - ocenu (score) je moguće promeniti samo zajedno sa sopstvenim glasom, pa svako ima najviše jedan glas
//  - brisati mogu autor i administratori; administrator je onaj čiji UID postoji u kolekciji "admins"
//  - samo administratori mogu da objavljuju na forumu "novosti" i da čitaju prijave
//  - svaki prijavljen korisnik može da napravi novi forum (kolekcija "forums"); brišu ga autor i administratori
//  - slike uz objave (kolekcija "images") i profilne slike (kolekcija "profiles") su mali JPEG-ovi u bazi
//  - profilnu sliku (kolekcija "profiles") menja samo vlasnik naloga; brisati je može i administrator

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function myName() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username;
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Ugrađeni forumi: lista mora da se poklapa sa BUILTIN u communities.js
    function builtinForum(c) {
      return c in ['novosti', 'opste', 'gaming', 'muzika', 'filmovi', 'sport', 'mimovi', 'saveti', 'tehnika', 'skola'];
    }

    // Forum je ugrađen ili ga je moderator napravio (dokument u "forums")
    function isValidCommunity(c) {
      return builtinForum(c) || exists(/databases/$(database)/documents/forums/$(c));
    }

    // Forumi na kojima objavljuju samo moderatori
    function adminOnlyForum(c) {
      return c == 'novosti'
        || (!builtinForum(c) && get(/databases/$(database)/documents/forums/$(c)).data.adminOnly == true);
    }

    // Glas korisnika za stavku (objavu ili komentar), pre i posle ove izmene
    function voteBefore(id) {
      let p = /databases/$(database)/documents/users/$(request.auth.uid)/votes/$(id);
      return exists(p) ? get(p).data.value : 0;
    }
    function voteAfter(id) {
      return getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/votes/$(id)).data.value;
    }
    function scoreMatchesVote(id) {
      return request.resource.data.score - resource.data.score == voteAfter(id) - voteBefore(id);
    }

    // Administratori: dokument se pravi ručno u konzoli (ID dokumenta = UID korisnika)
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Forumi koje prave moderatori. ID dokumenta je adresa foruma (npr. "anime").
    match /forums/{fid} {
      allow read: if true;
      allow create: if signedIn()
        && fid.matches('^[a-z0-9-]{2,24}$')
        && !builtinForum(fid)
        && request.resource.data.keys().hasOnly(['name', 'desc', 'emoji', 'color', 'adminOnly', 'createdBy', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 30
        && request.resource.data.desc is string
        && request.resource.data.desc.size() <= 120
        && request.resource.data.emoji is string
        && request.resource.data.emoji.size() >= 1
        && request.resource.data.emoji.size() <= 16
        && request.resource.data.color is string
        && request.resource.data.color.matches('^#[0-9A-Fa-f]{6}$')
        && request.resource.data.adminOnly is bool
        && (request.resource.data.adminOnly == false || isAdmin())
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // Slike uz objave: mali JPEG (data URL), objavi ga autor objave, briše autor ili administrator.
    match /images/{imageId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['data', 'authorId', 'createdAt'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 300000
        && request.resource.data.data.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // Profilne slike: ID dokumenta je korisničko ime malim slovima. Slika je mali JPEG (data URL).
    match /profiles/{name} {
      allow read: if true;
      allow create, update: if signedIn()
        && get(/databases/$(database)/documents/usernames/$(name)).data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['photo', 'updatedAt'])
        && request.resource.data.photo is string
        && request.resource.data.photo.size() <= 20000
        && request.resource.data.photo.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn()
        && (get(/databases/$(database)/documents/usernames/$(name)).data.uid == request.auth.uid || isAdmin());
    }

    // Rezervacija korisničkog imena (jedinstveno, bez obzira na velika i mala slova)
    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn()
        && name.matches('^[a-z0-9_.]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'usernameLower', 'createdAt'])
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[A-Za-z0-9_.]{3,20}$')
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == uid;
      allow update, delete: if false;

      // Moji glasovi: users/{uid}/votes/{id}
      match /votes/{id} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['value'])
          && request.resource.data.value in [-1, 0, 1];
        allow delete: if false;
      }
    }

    match /posts/{postId} {
      // Za zatvoren forum (samo prijavljeni čitaju) promeni u: allow read: if signedIn();
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['title', 'body', 'url', 'community', 'authorId', 'authorName', 'createdAt', 'score', 'commentCount', 'imageId'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName == myName()
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 150
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 5000
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 500
        && (request.resource.data.url == '' || request.resource.data.url.matches('^https?://.+'))
        && isValidCommunity(request.resource.data.community)
        && (!adminOnlyForum(request.resource.data.community) || isAdmin())
        && (!('imageId' in request.resource.data) || (request.resource.data.imageId is string && request.resource.data.imageId.size() <= 40))
        && request.resource.data.score == 0
        && request.resource.data.commentCount == 0
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn() && (
        (onlyChanges(['score']) && scoreMatchesVote(postId))
        || (onlyChanges(['commentCount'])
            && request.resource.data.commentCount == resource.data.commentCount + 1)
      );

      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    match /comments/{commentId} {
      // Za zatvoren forum promeni u: allow read: if signedIn();
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['postId', 'parentId', 'body', 'authorId', 'authorName', 'createdAt', 'score', 'deleted'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName == myName()
        && request.resource.data.postId is string
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId))
        && (request.resource.data.parentId == null || request.resource.data.parentId is string)
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 2000
        && request.resource.data.score == 0
        && request.resource.data.deleted == false
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn() && (
        (onlyChanges(['score']) && scoreMatchesVote(commentId))
        || ((resource.data.authorId == request.auth.uid || isAdmin())
            && onlyChanges(['body', 'deleted'])
            && request.resource.data.deleted == true
            && request.resource.data.body == '[obrisano]')
      );

      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['targetType', 'targetId', 'postId', 'reason', 'snippet', 'reporterId', 'createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in ['post', 'comment']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 300
        && request.resource.data.snippet is string
        && request.resource.data.snippet.size() <= 200
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }
  }
}
